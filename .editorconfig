# Formatter contract (PLAN §3.4, D-065): there is no Prettier; tools/lint.ts enforces the same whitespace rules.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = true

[*.py]
indent_size = 4

# Lint fixtures contain deliberate whitespace violations (tests/unit/tools/lint.test.ts).
[tests/fixtures/lint/**]
insert_final_newline = unset
trim_trailing_whitespace = unset
end_of_line = unset
indent_style = unset
