{
  "name": "echoes-of-aethelgard",
  "version": "2.0.0",
  "private": true,
  "description": "Echoes of Aethelgard: The Unraveling — a time-loop RPG for the browser.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "bun tools/dev.ts",
    "build": "npm run validate && bun tools/build.ts",
    "preview": "npm run build && node tools/serve.mjs dist 4173 --base /Aethelgard/",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "bun tools/lint.ts",
    "test": "bun test && bun tools/coverage-gate.ts",
    "test:e2e": "bun tools/build.ts --e2e && playwright test",
    "validate": "bun tools/validate-content.ts",
    "sim": "bun src/sim/cli.ts",
    "sim:balance": "bun --define __DEV__=false --define __E2E__=true tools/gen-balance.ts",
    "sim:batch": "bun --define __DEV__=false --define __E2E__=true src/sim/cli.ts batch",
    "sim:replay": "bun src/sim/cli.ts run --verbose",
    "check": "npm run typecheck && npm run lint && npm run validate && npm test && npm run build && npm run test:e2e -- --grep @smoke"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "esbuild": "0.28.2",
    "playwright": "1.56.0",
    "tsx": "4.23.12",
    "typescript": "6.0.3"
  }
}
