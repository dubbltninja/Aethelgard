e":1,"cr_arcane_wisp":1,"cr_drowned_archivist":2,"cr_shimmering_phantom":1,"cr_aetherial_weaver":1,"cr_pale_diver":2,"cr_tide_clerk":1},"seen":{"cr_corrupted_shade":1,"cr_arcane_wisp":1,"cr_drowned_archivist":2,"cr_shimmering_phantom":1,"cr_aetherial_weaver":1,"cr_pale_diver":2,"cr_tide_clerk":1},"damageDealt":617,"damageTaken":336,"damageBySource":{"elf_twin_strike":107,"basic":51,"elf_ambush":459},"abilitiesUsed":{"elf_twin_strike":10,"elf_ambush":21,"elf_barkskin":2},"itemsCrafted":0,"itemsUpgraded":0,"goldEarned":178,"goldSpent":0,"fights":7,"fightsWon":7,"fled":0,"rests":1,"travels":18,"questsCompleted":3,"questsFailed":0,"echoesGainedThisLoop":7,"deathsThisLoop":0,"custom":{"tally_kills":9},"resonance":21},"pendingEnding":null,"mode":"explore","recentLog":[{"step":0,"text":"A low, resonant hum vibrates under your skin, as if the stones are breathing.","kind":"event"},{"step":9,"text":"A whisper slips through the archway: 'Wayfinder... follow.'","kind":"event"},{"step":10,"text":"The scorch-hand on the wall is at the height of your own. You do not put yours in it.","kind":"event"},{"step":10,"text":"The growl ahead stops when you stop. It starts when you start.","kind":"event"},{"step":10,"text":"The growl ahead was never a growl. Something steps out of the wall.","kind":"combat"},{"step":15,"text":"A cold gust rattles the shelves, and you smell old ink and rain.","kind":"event"},{"step":15,"text":"A page turns itself on a shelf that no longer exists. You read one word before it is gone: 'Conflux.'","kind":"event"},{"step":15,"text":"Light knots itself between two shelves and turns toward you.","kind":"combat"},{"step":22,"text":"Collapsed shelves form jagged ridges of splintered wood and stone. Dust motes swirl in a dim glow, and you can almost hear pages turning on their own. In an alcove behind the fallen stacks, something small and bright waits in a cradle of stone.","kind":"narration"},{"step":22,"text":"Looking closer, you find something.","kind":"event"},{"step":39,"text":"A submerged page unfurls, whispering of the Ley Line Conflux.","kind":"event"},{"step":39,"text":"On the top step of the drowned stair sits a lantern etched with glyphs. The water below it is black, not dark.","kind":"event"},{"step":39,"text":"In the carrel under the east stair a sodden figure clutches a scroll and turns her back to you.","kind":"combat"},{"step":50,"text":"Magic +1 for the rest of this loop.","kind":"event"},{"step":57,"text":"The Heartstone answers your presence with a tremor that shakes dust from the ceiling.","kind":"event"},{"step":67,"text":"Light fractures into false paths, then snaps back into focus.","kind":"event"},{"step":67,"text":"In the cleft a man in a Wayfinder's coat raises a hand. He is gone before it finishes rising.","kind":"event"},{"step":67,"text":"The path doubles. One of the two has teeth.","kind":"combat"},{"step":74,"text":"You walked a path that was not there.","kind":"event"},{"step":74,"text":"The spires throb in unison, a slow heartbeat of raw arcana.","kind":"event"},{"step":74,"text":"The hum is not random. It is a chord, held for five hundred years, and it is a little flat.","kind":"event"},{"step":74,"text":"A strand of light unspools from the nearest spire and turns toward you.","kind":"combat"},{"step":83,"text":"You rest in Dask's hollow, a cleft that is always the same temperature.","kind":"narration"},{"step":85,"text":"You find a name you know on the wall. DANTHE. Below it, smaller: and her daughter.","kind":"event"},{"step":85,"text":"Two pale figures stand on the rim, each holding a lamp that has not been lit in a hundred years.","kind":"combat"},{"step":98,"text":"The lamps under the water do not flicker. Someone tends them.","kind":"event"},{"step":103,"text":"A ledger lists the drowned by street. The last entry is in a different hand: 'and the Warden of Waters, by her own choice.'","kind":"event"},{"step":103,"text":"A clerk in a drowned coat looks up from the ledger. Beside it a reader keeps its place with a wet finger.","kind":"combat"},{"step":110,"text":"Pellam pours you something hot without asking. 'The bell rang twice last night,' he says. 'It never rings twice.'","kind":"event"}],"threshold":null}}},
