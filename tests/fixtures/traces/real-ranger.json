wler":1,"kills:cr_corrupted_shade":1,"kills:cr_arcane_wisp":1,"kills:cr_drowned_archivist":1,"stageDay":3,"stage:descend":1,"stage:choose":2,"stage:done_stabilize":3},"objectivesDone":[]}},"flags":{"flag_scene_done_scene_first_meeting_ilyra":true,"flag_scene_done_scene_ilyra_echo_crystal_waiting":true,"flag_spellbook_dropped":true,"flag_scene_done_scene_dray_idle":true,"flag_crystal_given":true,"flag_scene_done_scene_echo_crystal":true,"flag_scene_done_scene_ilyra_crystal_deciphered":true,"flag_scene_done_scene_ilyra_lost_scroll_return":true,"flag_scene_done_scene_ilyra_conflux":true,"flag_heartstone_stabilized":true,"flag_scene_done_scene_heartstone_choice":true},"reputation":{"remnants":40,"weavers":-3,"ironclad":0},"echoesThisLoop":["echo_crystal_location","echo_litany_verse_1","echo_oriel_lineage","echo_archive_door","echo_heartstone_path","echo_heartstone_resonance"],"combat":null,"dialogue":null,"merchants":{},"rng":[2975377188,293962122,2866861173,360473897],"counters":{"kills":{"cr_mistwood_prowler":1,"cr_corrupted_shade":1,"cr_arcane_wisp":1,"cr_drowned_archivist":1,"cr_shimmering_phantom":1,"cr_aetherial_weaver":1},"seen":{"cr_mistwood_prowler":1,"cr_corrupted_shade":1,"cr_arcane_wisp":1,"cr_drowned_archivist":1,"cr_shimmering_phantom":1,"cr_aetherial_weaver":1},"damageDealt":400,"damageTaken":257,"damageBySource":{"rgr_rend":132,"status:status_bleed":28,"basic":80,"rgr_marked_shot":52,"rgr_piercing_arrow":108},"abilitiesUsed":{"rgr_rend":7,"rgr_marked_shot":6,"rgr_venom_coat":2,"rgr_piercing_arrow":6},"itemsCrafted":0,"itemsUpgraded":0,"goldEarned":110,"goldSpent":0,"fights":6,"fightsWon":6,"fled":0,"rests":1,"travels":14,"questsCompleted":3,"questsFailed":0,"echoesGainedThisLoop":6,"deathsThisLoop":0,"custom":{"tally_kills":6},"resonance":18},"pendingEnding":null,"mode":"explore","recentLog":[{"step":0,"text":"A low, resonant hum vibrates under your skin, as if the stones are breathing.","kind":"event"},{"step":9,"text":"A whisper slips through the archway: 'Wayfinder... follow.'","kind":"event"},{"step":9,"text":"The fog under the arch has eyes in it.","kind":"combat"},{"step":12,"text":"The scorch-hand on the wall is at the height of your own. You do not put yours in it.","kind":"event"},{"step":12,"text":"The growl ahead stops when you stop. It starts when you start.","kind":"event"},{"step":12,"text":"The growl ahead was never a growl. Something steps out of the wall.","kind":"combat"},{"step":15,"text":"A cold gust rattles the shelves, and you smell old ink and rain.","kind":"event"},{"step":15,"text":"A page turns itself on a shelf that no longer exists. You read one word before it is gone: 'Conflux.'","kind":"event"},{"step":15,"text":"Light knots itself between two shelves and turns toward you.","kind":"combat"},{"step":22,"text":"Collapsed shelves form jagged ridges of splintered wood and stone. Dust motes swirl in a dim glow, and you can almost hear pages turning on their own. In an alcove behind the fallen stacks, something small and bright waits in a cradle of stone.","kind":"narration"},{"step":22,"text":"Looking closer, you find something.","kind":"event"},{"step":37,"text":"A submerged page unfurls, whispering of the Ley Line Conflux.","kind":"event"},{"step":37,"text":"On the top step of the drowned stair sits a lantern etched with glyphs. The water below it is black, not dark.","kind":"event"},{"step":37,"text":"In the carrel under the east stair a sodden figure clutches a scroll and turns her back to you.","kind":"combat"},{"step":47,"text":"Magic +1 for the rest of this loop.","kind":"event"},{"step":54,"text":"The Heartstone answers your presence with a tremor that shakes dust from the ceiling.","kind":"event"},{"step":64,"text":"Light fractures into false paths, then snaps back into focus.","kind":"event"},{"step":64,"text":"In the cleft a man in a Wayfinder's coat raises a hand. He is gone before it finishes rising.","kind":"event"},{"step":64,"text":"The path doubles. One of the two has teeth.","kind":"combat"},{"step":79,"text":"You rest in Dask's hollow, a cleft that is always the same temperature.","kind":"narration"},{"step":80,"text":"You walked a path that was not there.","kind":"event"},{"step":80,"text":"The spires throb in unison, a slow heartbeat of raw arcana.","kind":"event"},{"step":80,"text":"The hum is not random. It is a chord, held for five hundred years, and it is a little flat.","kind":"event"},{"step":80,"text":"A strand of light unspools from the nearest spire and turns toward you.","kind":"combat"}],"threshold":null}}},
