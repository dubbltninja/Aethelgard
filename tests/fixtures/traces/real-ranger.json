marrow":{"stock":[{"uid":"i30","itemId":"item_glow_moss","qty":3,"rarity":"common","affixes":[]},{"uid":"i31","itemId":"item_brine_draught","qty":3,"rarity":"common","affixes":[]},{"uid":"i32","itemId":"item_lantern_oil","qty":3,"rarity":"common","affixes":[]},{"uid":"i33","itemId":"item_antidote_root","qty":2,"rarity":"common","affixes":[]},{"uid":"i34","itemId":"item_ley_touched_tonic","qty":2,"rarity":"common","affixes":[]},{"uid":"i35","itemId":"mat_drowned_pearl","qty":1,"rarity":"common","affixes":[]},{"uid":"i36","itemId":"item_divers_coat","qty":1,"rarity":"common","affixes":[]},{"uid":"i37","itemId":"item_scriptorium_staff","qty":1,"rarity":"epic","affixes":["affix_of_ley"]}],"lastRestockDay":4,"purchasesThisLoop":0}},"rng":[292483559,1008830360,2382309639,3686242440],"counters":{"kills":{"cr_mistwood_prowler":3,"cr_corrupted_shade":1,"cr_arcane_wisp":2,"cr_drowned_archivist":1,"cr_tide_clerk":1},"seen":{"cr_mistwood_prowler":3,"cr_corrupted_shade":1,"cr_arcane_wisp":2,"cr_tide_clerk":1,"cr_drowned_archivist":1},"damageDealt":404,"damageTaken":322,"damageBySource":{"rgr_rend":111,"status:status_bleed":20,"rgr_marked_shot":241,"basic":32},"abilitiesUsed":{"rgr_rend":6,"rgr_marked_shot":18},"itemsCrafted":0,"itemsUpgraded":0,"goldEarned":85,"goldSpent":0,"fights":6,"fightsWon":6,"fled":0,"rests":1,"travels":10,"questsCompleted":0,"questsFailed":0,"echoesGainedThisLoop":1,"deathsThisLoop":0,"custom":{"tally_kills":8},"resonance":15},"pendingEnding":null,"mode":"explore","recentLog":[{"step":0,"text":"A low, resonant hum vibrates under your skin, as if the stones are breathing.","kind":"event"},{"step":9,"text":"A whisper slips through the archway: 'Wayfinder... follow.'","kind":"event"},{"step":9,"text":"The fog under the arch has eyes in it.","kind":"combat"},{"step":12,"text":"The scorch-hand on the wall is at the height of your own. You do not put yours in it.","kind":"event"},{"step":12,"text":"The growl ahead stops when you stop. It starts when you start.","kind":"event"},{"step":12,"text":"The growl ahead was never a growl. Something steps out of the wall.","kind":"combat"},{"step":15,"text":"A cold gust rattles the shelves, and you smell old ink and rain.","kind":"event"},{"step":15,"text":"A page turns itself on a shelf that no longer exists. You read one word before it is gone: 'Conflux.'","kind":"event"},{"step":15,"text":"Light knots itself between two shelves and turns toward you.","kind":"combat"},{"step":22,"text":"Wild magic surges. A chorus of distant bells rings out, then fades.","kind":"event"},{"step":22,"text":"A knot of light lifts off the fountain's rim.","kind":"combat"},{"step":25,"text":"You crush a leaf without meaning to. The smell is clean. Nothing here has been clean in a long time.","kind":"event"},{"step":25,"text":"A shape between the trunks keeps your pace for ten steps, then is a tree.","kind":"event"},{"step":25,"text":"Two shapes pace you through the fog, one on each side of the trail.","kind":"combat"},{"step":36,"text":"You make camp beneath the twisted trees. The whispers keep you company.","kind":"narration"},{"step":39,"text":"A submerged page unfurls, whispering of the Ley Line Conflux.","kind":"event"},{"step":39,"text":"On the top step of the drowned stair sits a lantern etched with glyphs. The water below it is black, not dark.","kind":"event"},{"step":42,"text":"The lamps under the water do not flicker. Someone tends them.","kind":"event"},{"step":44,"text":"A ledger lists the drowned by street. The last entry is in a different hand: 'and the Warden of Waters, by her own choice.'","kind":"event"},{"step":44,"text":"A clerk in a drowned coat looks up from the ledger. Beside it a reader keeps its place with a wet finger.","kind":"combat"},{"step":62,"text":"Pellam pours you something hot without asking. 'The bell rang twice last night,' he says. 'It never rings twice.'","kind":"event"}],"threshold":null}}},
