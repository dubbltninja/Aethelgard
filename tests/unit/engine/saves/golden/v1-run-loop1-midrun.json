        "kind": "narration"
      },
      {
        "step": 42,
        "text": "Hammer strikes ring out like a steady heartbeat.",
        "kind": "event"
      },
      {
        "step": 57,
        "text": "A low hum rises from the abyss, vibrating with hungry intent.",
        "kind": "event"
      },
      {
        "step": 70,
        "text": "You gather Ley Resin.",
