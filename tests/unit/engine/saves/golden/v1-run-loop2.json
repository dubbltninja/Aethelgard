    "recentLog": [
      {
        "step": 0,
        "text": "A low, resonant hum vibrates under your skin, as if the stones are breathing.",
        "kind": "event"
      },
      {
        "step": 0,
        "text": "You know this smell. You have stood here before, and the stones know it too.",
        "kind": "event"
      },
      {
        "step": 13,
        "text": "A whisper slips through the archway: 'Wayfinder... follow.'",
        "kind": "event"
      },
      {
        "step": 13,
        "text": "The fog under the arch has eyes in it.",
        "kind": "combat"
      },
      {
        "step": 16,
        "text": "The scorch-hand on the wall is at the height of your own. You do not put yours in it.",
        "kind": "event"
      },
      {
        "step": 16,
        "text": "The growl ahead stops when you stop. It starts when you start.",
        "kind": "event"
      },
      {
        "step": 16,
        "text": "The growl ahead was never a growl. Something steps out of the wall.",
        "kind": "combat"
      },
      {
        "step": 19,
        "text": "A cold gust rattles the shelves, and you smell old ink and rain.",
        "kind": "event"
      },
      {
        "step": 19,
        "text": "A page turns itself on a shelf that no longer exists. You read one word before it is gone: 'Conflux.'",
        "kind": "event"
      },
      {
        "step": 19,
        "text": "The seam in the air widens a hair when you look at it. It knows you.",
        "kind": "event"
      },
      {
        "step": 19,
        "text": "Light knots itself between two shelves and turns toward you.",
        "kind": "combat"
      },
      {
        "step": 32,
        "text": "Wild magic surges. A chorus of distant bells rings out, then fades.",
        "kind": "event"
      },
      {
        "step": 32,
        "text": "A knot of light lifts off the fountain's rim.",
        "kind": "combat"
      },
      {
        "step": 35,
        "text": "You crush a leaf without meaning to. The smell is clean. Nothing here has been clean in a long time.",
        "kind": "event"
      },
      {
        "step": 35,
        "text": "A shape between the trunks keeps your pace for ten steps, then is a tree.",
        "kind": "event"
      },
      {
        "step": 35,
        "text": "Two shapes pace you through the fog, one on each side of the trail.",
        "kind": "combat"
      },
